{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "out",
    "lib": ["es6","dom"],
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "mocha", "vscode"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": true /* enable all strict type-checking options */
  },
  "exclude": ["node_modules", ".vscode-test", "testdata"]
}
